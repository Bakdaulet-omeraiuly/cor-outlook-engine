{
  "name": "cor-outlook-engine",
  "version": "0.1.0",
  "description": "Pure-TypeScript, cohort-level organ-outlook simulation library. Computes how an organ's modeled parameters change under a set of clinical interventions, with cited effect distributions and Monte Carlo uncertainty. Decision support only, not an individual prediction.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "cor-outlook": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "cli": "node --import tsx src/cli/index.ts"
  },
  "keywords": [
    "cohort",
    "simulation",
    "cardiology",
    "neurology",
    "decision-support",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "eslint": "^9.11.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^2.1.1"
  }
}
